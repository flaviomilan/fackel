# =============================================================================
# Fackel Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Only OPENAI_API_KEY is required — everything else is optional.
#
#   cp .env.example .env

# -----------------------------------------------------------------------------
# OpenAI API (Required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Per-Agent Model Selection (Optional)
# -----------------------------------------------------------------------------
# Each agent reads FACKEL_MODEL_{AGENT} and falls back to gpt-5-mini.
# Uncomment to override individual agents.
# Supports provider prefix syntax: openai:gpt-5-mini, ollama:llama3.1,
# copilot:openai/gpt-4o.
#
# FACKEL_MODEL_OSINT=gpt-5-mini
# FACKEL_MODEL_PORT_SCAN=gpt-5-mini
# FACKEL_MODEL_VULN_SCAN=gpt-5-mini
# FACKEL_MODEL_TRIAGE=gpt-5-mini
# FACKEL_MODEL_REPORT=gpt-4o
# FACKEL_MODEL_JUDGE=gpt-5-mini

# -----------------------------------------------------------------------------
# GitHub Models API / Copilot (Optional — alternative to OpenAI)
# -----------------------------------------------------------------------------
# Use models from GitHub Models API (https://models.github.ai) instead of
# (or alongside) a direct OpenAI key.  Requires a GitHub Personal Access Token.
#
# NOTE: The free tier enforces strict per-request token limits (8K input).
# Fackel prompts exceed this (~15K+).  You must opt in to paid usage:
# https://docs.github.com/en/billing/managing-billing-for-your-products/about-billing-for-github-models
#
# FACKEL_LLM_PROVIDER=copilot
# FACKEL_DEFAULT_MODEL=openai/gpt-4.1
# GITHUB_TOKEN=ghp_...
# FACKEL_COPILOT_API_BASE=https://models.github.ai/inference

# -----------------------------------------------------------------------------
# LangSmith Observability (Optional)
# -----------------------------------------------------------------------------
# Set both vars to enable automatic LLM tracing via LangSmith.
# All agent phases appear as hierarchical traces — no code changes needed.
# Get a free API key at https://smith.langchain.com
#
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=fackel

# -----------------------------------------------------------------------------
# Per-Tool Timeout Overrides (Optional)
# -----------------------------------------------------------------------------
# Override subprocess timeouts per tool via FACKEL_TIMEOUT_{TOOL_NAME}.
# Value in seconds. Defaults are typically 180s.
#
# FACKEL_TIMEOUT_NMAP_PORT_SCAN=300
# FACKEL_TIMEOUT_NUCLEI_SCAN=600
# FACKEL_TIMEOUT_SUBFINDER_ENUM=60

# -----------------------------------------------------------------------------
# External Tool API Keys (Optional)
# -----------------------------------------------------------------------------
# Tools with missing keys are automatically removed from agents.
# The scan still runs — it just uses fewer data sources.

# Shodan — passive service/banner data (shodan_lookup)
SHODAN_API_KEY=

# VirusTotal — passive subdomain enumeration (virustotal_subdomain_enum)
VIRUSTOTAL_API_KEY=

# Censys — host/service search (censys_lookup) — both required
CENSYS_API_ID=
CENSYS_API_SECRET=

# FOFA — asset search engine (fofa_search) — both required
FOFA_EMAIL=
FOFA_KEY=

# SecurityTrails — historical DNS records (securitytrails_history)
SECURITYTRAILS_API_KEY=

# AlienVault OTX — passive DNS records (otx_passive_dns)
OTX_API_KEY=

# HaveIBeenPwned — email breach data (analyze_email, graceful degradation)
HIBP_API_KEY=

# EmailRep — email reputation scoring (analyze_email, graceful degradation)
EMAILREP_API_KEY=

# WPScan — WordPress vulnerability scanning (wpscan_scan)
WPSCAN_API_TOKEN=

# -----------------------------------------------------------------------------
# Centralized Operational Settings (Optional)
# -----------------------------------------------------------------------------
# All settings below have sensible defaults. Override as needed.
# Full reference: docs/configuration.md → Operational settings

# -- Scan orchestration --
# FACKEL_SCAN_TIMEOUT=3600              # Global scan timeout in seconds (0 disables)
# FACKEL_MAX_AGENT_ITERATIONS=50        # Max tool calls per agent phase (0 disables the limit)
# FACKEL_MAX_PIVOTS=2                    # Max entity-driven OSINT pivot passes (0 disables)
# FACKEL_OSINT_SPECIALISTS=true          # OSINT as focused specialist sub-agents (false = single agent)
# FACKEL_VULN_SPECIALISTS=true           # Vuln-scan as parallel specialist sub-agents (false = single agent).
                                          # Active scan: parallel = faster but concurrent traffic to the target.
                                          # Per-tool HITL approval forces the single-agent path regardless.
# FACKEL_BUDGET_WARNING_RATIO=0.8       # Warn agent at this fraction of budget

# -- Default LLM model --
# FACKEL_DEFAULT_MODEL=gpt-5-mini       # Fallback model for all agents

# -- LLM provider tuning --
# FACKEL_LLM_REQUEST_TIMEOUT=120        # Per-request LLM timeout (seconds)
# FACKEL_LLM_MAX_RETRIES=1              # Transient LLM error retries
# FACKEL_LLM_RETRY_DELAY=5.0            # Initial delay between LLM retries (seconds)

# -- Tool retry middleware --
# FACKEL_TOOL_RETRY_MAX_RETRIES=2       # ToolRetryMiddleware max retries
# FACKEL_TOOL_RETRY_BACKOFF_FACTOR=2.0  # Backoff multiplier
# FACKEL_TOOL_RETRY_INITIAL_DELAY=1.0   # Initial delay (seconds)

# -- Subprocess execution --
# FACKEL_SUBPROCESS_TIMEOUT=180         # Default subprocess timeout (seconds)
# FACKEL_SUBPROCESS_MAX_OUTPUT=2097152  # Max bytes per stdout/stderr (2 MiB)

# -- Output sanitizer --
# FACKEL_SANITIZER_MAX_BYTES=50000      # Max tool output before truncation

# -- HTTP client --
# FACKEL_HTTP_RETRY_TOTAL=2             # Total retries for shared HTTP session
# FACKEL_HTTP_BACKOFF_FACTOR=1.0        # Backoff factor for HTTP retries

# -- Circuit breaker --
# FACKEL_CIRCUIT_BREAKER_THRESHOLD=3    # Failures before opening circuit
# FACKEL_CIRCUIT_BREAKER_RESET_TIMEOUT=60  # Seconds before half-open probe

# -- Logging --
# FACKEL_LOG_FORMAT=text                # "text" or "json"

# -- CLI presentation --
# FACKEL_NERD_FONT=true                 # Nerd Font glyphs in the terminal UI (false = ASCII fallback)

# -----------------------------------------------------------------------------
# Orchestrator Checkpointer (Optional)
# -----------------------------------------------------------------------------
# SQLite database path for graph state persistence and interrupt/resume.
# Default: ~/.fackel/checkpoints.db
#
# FACKEL_CHECKPOINT_DB=~/.fackel/checkpoints.db

# -----------------------------------------------------------------------------
# MongoDB (Optional — for scan persistence)
# -----------------------------------------------------------------------------
# MONGO_URI=mongodb://fackel:fackelpass@localhost:27017/fackel?authSource=admin
# MONGO_DB_NAME=fackel
# MONGO_USERNAME=fackel
# MONGO_PASSWORD=fackelpass
